# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/blog_builder?schema=public"

# Secret used to sign auth JWTs (use a long random string: `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-string"

# Public self-signup: "approval" (default; an admin must approve new accounts),
# "open" (active immediately) or "closed" (admins create all accounts).
# The older ALLOW_SIGNUP="false" is still treated as "closed".
SIGNUP_MODE="approval"

# Credentials for the admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@analyticsliv.com"
SEED_ADMIN_PASSWORD="Admin@123"

# Set to "false" to hide the one-click demo account buttons on the login page
SHOW_DEMO_ACCOUNTS="true"

# Absolute site URL used for Open Graph metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
